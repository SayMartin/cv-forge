# --- Database (existing self-hosted Postgres container, new DB/user created for this app) ---
DATABASE_URL=postgresql://cvforge:changeme@postgres:5432/cvforge
DIRECT_URL=postgresql://cvforge:changeme@postgres:5432/cvforge

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=                    # openssl rand -base64 32
BETTER_AUTH_URL=https://cv-forge.appfinningar.se

GOOGLE_CLIENT_ID=                      # Google Cloud Console → OAuth 2.0 credentials
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=                        # Resend dashboard → API Keys
EMAIL_FROM=CV Forge <noreply@appfinningar.se>

# --- AI (CV import from PDF) ---
GEMINI_API_KEY=                        # Google AI Studio

# --- File storage (MinIO, self-hosted S3-compatible) ---
# S3_ENDPOINT is the internal address the app container uses to reach MinIO.
# S3_PUBLIC_URL is the public address browsers use to load uploaded images
# (proxied through Nginx Proxy Manager + Cloudflare Tunnel).
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://files.appfinningar.se
S3_BUCKET=cv-forge
S3_ACCESS_KEY_ID=                      # same value as MINIO_ROOT_USER below
S3_SECRET_ACCESS_KEY=                  # same value as MINIO_ROOT_PASSWORD below

# --- MinIO container credentials (used by docker-compose.yml directly) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
