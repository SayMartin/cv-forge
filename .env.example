# --- Database (existing self-hosted Postgres container, new DB/user created for this app) ---
DATABASE_URL=postgresql://cvforge:changeme@postgres:5432/cvforge
DIRECT_URL=postgresql://cvforge:changeme@postgres:5432/cvforge

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=                    # openssl rand -base64 32
BETTER_AUTH_URL=https://cv-forge.appfinningar.se

GOOGLE_CLIENT_ID=                      # Google Cloud Console → OAuth 2.0 credentials
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=                        # Resend dashboard → API Keys
EMAIL_FROM=CV Forge <noreply@appfinningar.se>

# --- AI (CV import from PDF) ---
GEMINI_API_KEY=                        # Google AI Studio

# --- File storage (Cloudflare R2, S3-compatible) ---
# S3_ENDPOINT is R2's S3 API endpoint for this account (R2 dashboard → API → S3 API).
# S3_PUBLIC_URL is the Custom Domain connected to the bucket (R2 bucket → Settings → Custom Domain).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://files.appfinningar.se
S3_BUCKET=cv-forge-bucket
S3_ACCESS_KEY_ID=                      # R2 API Token → Access Key ID
S3_SECRET_ACCESS_KEY=                  # R2 API Token → Secret Access Key
