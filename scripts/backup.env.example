# Copy to backup.env on the server and fill in. Never commit the filled-in file —
# .gitignore already covers .env*, but this one is named differently, so it is
# listed explicitly there too.

# ─── Database ────────────────────────────────────────────────────────────────
# Container name of the existing Postgres instance (docker ps).
PG_CONTAINER=
PG_USER=cvforge
PG_DB=cvforge

# ─── Cloudflare R2 — backup bucket ───────────────────────────────────────────
# A DIFFERENT bucket and a DIFFERENT token than the app's avatar storage. The
# avatars bucket is public via a Custom Domain; this one must be private, with no
# Custom Domain attached. Scope the API token to this bucket only, so the nightly
# job cannot touch avatar images.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_BUCKET=cvforge-backups

# ─── Encryption ──────────────────────────────────────────────────────────────
# age PUBLIC key (starts age1...). Generate the pair somewhere that is NOT this
# server:
#
#   age-keygen -o cvforge-backup.key
#
# Put the private key in your password manager, and only the public recipient
# line below on the server. The server can then encrypt backups but never read
# them — which is the whole point. Restoring:
#
#   age --decrypt -i cvforge-backup.key cvforge-….dump.age > restore.dump
#   docker exec -i <pg> pg_restore -U cvforge -d cvforge_restore < restore.dump
AGE_RECIPIENT=

# ─── Local copies ────────────────────────────────────────────────────────────
# Convenience only; the copy that matters is the one in R2. Remote retention is
# an R2 lifecycle rule on the bucket, not this script's job.
BACKUP_DIR=/home/USER/backups/cvforge
KEEP_LOCAL=7
