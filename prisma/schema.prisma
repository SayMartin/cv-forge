// Prisma schema for cv-cms
// Runtime: Neon (PostgreSQL) via DATABASE_URL
// Auth: Better Auth — schema matches Better Auth core + admin plugin
// Migrations: managed with `prisma migrate dev`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core schema ───────────────────────────────────────────────────

model User {
  id              String          @id
  name            String
  email           String          @unique
  emailVerified   Boolean
  image           String?
  createdAt       DateTime
  updatedAt       DateTime
  // Better Auth admin plugin fields
  role            String?
  banned          Boolean?
  banReason       String?
  banExpires      DateTime?
  /// The account's UI language ("sv" | "en"), or NULL when the user has never
  /// chosen one.
  ///
  /// Nullable rather than `@default("en")`, and the distinction is load-bearing.
  /// Signing in copies this into the locale cookie, so a default of "en" would
  /// mean every existing account — none of which has ever expressed a preference
  /// — flips a Swedish visitor to English the first time they sign in after this
  /// ships. NULL says "no opinion", and the browser's own negotiation is left to
  /// stand. It is also the rollback-safe shape, for the reason `Account.issuer`
  /// documents: old code that omits the column still inserts.
  ///
  /// Not a Postgres enum: the value is validated by `isLocale()` on every read
  /// and write, and an enum would make adding a third language a table-locking
  /// migration instead of a one-line change to `LOCALES`.
  locale          String?
  sessions        Session[]
  accounts        Account[]
  cvs             CV[]
  cvThemes        CvTheme[]
  profiles        Profile[]
  avatar          Avatar?
  experiences     Experience[]
  educations      Education[]
  skills          Skill[]
  skillCategories SkillCategory[]
  projects        Project[]
  others          Other[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Better Auth admin plugin field
  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  // Required by Better Auth from 1.7 on, which matches it during credential
  // sign-in. Synthetic for providers that declare no issuer of their own:
  // "local:credential" for email+password, "local:oauth:<id>" for OAuth.
  //
  // Nullable on purpose even though Better Auth always writes it. The column is
  // added before the new image ships, and a rollback to the previous image runs
  // 1.6 code that does not write the field — NOT NULL would break account
  // creation in exactly the situation where rolling back is the goal. Tighten it
  // in a follow-up migration once 1.7 has proven itself.
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hashed by Better Auth (credentials provider)
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ─── CV compositions ──────────────────────────────────────────────────────────

model CV {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layoutId      String   @default("default")
  themeId       String?
  theme         CvTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  // Selected content IDs per section (loose string refs, no FK — mirrors experienceIds etc.)
  profileId     String?
  avatarIndex   Int?
  experienceIds String[]
  educationIds  String[]
  skillIds      String[]
  // Per-CV skill composition: [{ categoryId, skillIds: [...] }].
  //
  // Array order is display order, for both the groups and the skills inside them;
  // presence is visibility. This lives on the CV, not on the skill, so two CVs can
  // arrange the same library differently — the same separation `experienceIds` and
  // `sectionOrder` already use.
  //
  // `skillIds` above stays the selection, and is kept a subset of the ids appearing
  // here: a skill that is not placed in a group cannot be selected. The API enforces
  // that on write so the two fields cannot drift apart.
  skillGroups   Json?
  projectIds    String[]
  // @default([]) mirrors the DB default added by 20260726140000_backfill_null_arrays
  // after the 2026-07-26 outage. Without it declared here, Prisma reads the default
  // as drift and emits a DROP DEFAULT into the next unrelated migration.
  otherIds      String[] @default([])
  // Section order for the CV renderer (e.g. ["experience","education","skills","projects","other"])
  // @default([]) as for otherIds above — same migration, same reason.
  sectionOrder  String[] @default([])
  // When true, experience/education/projects/other are merged into one date-sorted timeline instead of grouped by section
  chronological Boolean  @default(false)
  /// The language the CV itself is written in — section headings, "Present",
  /// date formatting. Deliberately **not** the UI locale: a Swedish speaker
  /// applying abroad keeps a Swedish interface while producing an English CV,
  /// which is the common case, not the exotic one.
  ///
  /// `NOT NULL DEFAULT 'en'` here, unlike `User.locale`, because "en" is real
  /// data rather than a guess: every CV that exists today was authored with
  /// English headings and en-GB dates, so this default leaves every stored row
  /// rendering byte-identically. That matters more than it looks — changing a
  /// CV's language changes rendered text width, and `Paginated.tsx` measures
  /// that to decide where the page breaks fall.
  ///
  /// Not consumed until the layouts are taught to read it; it ships in this
  /// migration because pushing to `main` IS the production migration, and two
  /// pushes would be two production events for one change.
  language      String   @default("en")
  // Metadata
  targetRole    String?
  coverLetter   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("cv")
}

// ─── CV themes (user-scoped, reusable) ───────────────────────────────────────

model CvTheme {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  sidebarColor String   @default("#2d2d2d")
  accentColor  String   @default("#c9a84c")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cvs          CV[]

  @@map("cv_theme")
}

// ─── CV content ───────────────────────────────────────────────────────────────

model Profile {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileName    String
  name           String?
  headline       String?
  bio            String?
  email          String?
  phone          String?
  location       String?
  linkedin       String?
  github         String?
  website        String?
  portfolio      String?
  // Europass CV fields (all optional — only required when exporting a Europass layout)
  nationality    String?
  dateOfBirth    DateTime?
  drivingLicense String? // e.g. "B", "A, B, C1"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("profile")
}

model Avatar {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  images    String[] // up to 5 R2 image URLs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("avatar")
}

model Experience {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  role        String
  startDate   String?
  endDate     String?
  current     Boolean  @default(false)
  description String?
  url         String?
  skills      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("experience")
}

model Education {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  degree      String?
  field       String?
  startDate   String?
  endDate     String?
  current     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("education")
}

// User-owned, renameable, reorderable skill groups. Seeded with defaults on
// sign-up; the taxonomy is the user's, not the product's — not every user is a
// developer.
model SkillCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // "language" | "normal". The spoken-language group drives the CEFR field in the
  // editor and the CEFR table in the Europass layout. That role is stored here,
  // separately from `name`, so the group can be renamed ("Språk", "Idiomas")
  // without either feature silently breaking — the failure mode of matching on
  // the heading text instead.
  kind      String   @default("normal")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]

  @@unique([userId, name])
  @@map("skill_category")
}

model Skill {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  // ─── DEPRECATED ────────────────────────────────────────────────────────────
  // A skill no longer owns a category or a display order: both are per-CV
  // decisions, stored in `cv.skillGroups`. These three columns are read only by
  // the backfill in 20260821_move_skill_grouping_to_cv and are kept for one
  // release so that backfill stays auditable. Drop them together afterwards.
  categoryId     String?
  category       SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  legacyCategory String?
  order          Int            @default(0)
  // ───────────────────────────────────────────────────────────────────────────
  level          Int? // 1–5
  cefrLevel      String? // A1 / A2 / B1 / B2 / C1 / C2 — set only on a "language"-kind category
  icon           String? // image URL
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("skill")
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  slug        String?
  summary     String?
  startDate   String?
  endDate     String?
  current     Boolean   @default(false)
  body        String? // markdown / plain text
  imageUrl    String?
  url         String?
  sourceUrl   String?
  skills      String[]
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, slug])
  @@map("project")
}

model Other {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?
  date        String?
  description String?
  url         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("other")
}

