# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# Sanity (removed — legacy Studio build output and runtime)
/.sanity

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Prisma local dev database
prisma/dev.db
prisma/dev.db-journal

# Cloudflare local state
.wrangler/

# OpenNext build output
.open-next/


# backup script secrets (see scripts/backup.env.example)
scripts/backup.env

# personal notes — not project documentation
GIT-DEMO.md
